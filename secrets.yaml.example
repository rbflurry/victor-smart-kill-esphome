# Copy this file to `secrets.yaml` and fill in your own values.
# `secrets.yaml` holds credentials -- keep it OUT of git (add it to .gitignore).

wifi_ssid: "your-wifi-ssid"
wifi_password: "your-wifi-password"

# Fallback setup hotspot (local-kill-setup) password. Must be at least 8 characters.
ap_password: "choose-a-setup-password"

# 32-byte base64 key for the encrypted Home Assistant API.
# Generate one with:  openssl rand -base64 32
# (or use the key generator at https://esphome.io/components/api.html)
# Enter this same key in Home Assistant when it adds the device.
api_key: "REPLACE_WITH_32_BYTE_BASE64_KEY"
